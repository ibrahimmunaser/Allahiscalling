<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Time Sensitive Notifications: lets prayer reminders break through
	     Focus modes and scheduled summaries. Required for
	     InterruptionLevel.timeSensitive to take effect; without it iOS
	     silently downgrades delivery to ordinary notifications.
	     The provisioning profile / signing team must also support this
	     capability (verify in Xcode: Runner > Signing & Capabilities). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- App Guard (Screen Time shield): requires Apple's approval before
	     this entitlement works on a real device/App Store build — request
	     it at https://developer.apple.com/contact/request/family-controls-distribution
	     (see IOS_SCREEN_TIME_SETUP.md). Without approval, FamilyControls
	     authorization calls fail gracefully (AppGuardManager reports
	     "unsupported"); the rest of the app is unaffected either way. -->
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!-- Shares the user's guarded-app selection and the active prayer name
	     with the three Screen Time extensions (DeviceActivityMonitor,
	     ShieldConfiguration, ShieldAction) — see GuardShared.swift. Must
	     also be enabled as an App Group capability on the Apple Developer
	     portal for this bundle ID and each extension's bundle ID. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.salahinvite.allahInvitesYouToSalah</string>
	</array>
	<!-- AlarmKit: deliberately NOT added here. Apple's own AlarmKit docs
	     (WWDC25, developer.apple.com/documentation/alarmkit) describe setup
	     as ONLY NSAlarmKitUsageDescription (see Info.plist) + calling
	     AlarmManager.requestAuthorization() — no entitlement is mentioned
	     anywhere in Apple's official documentation. Third-party blog posts
	     claim a special entitlement is required, but that is NOT confirmed
	     by Apple and is not being taken on faith here — see
	     IOS_ALARMKIT_ENTITLEMENT.md at the repo root for the full
	     evidence review and the exact steps to verify this on a Mac before
	     ever hand-adding a key here. A wrong/unsupported entitlement key
	     can break code signing for the whole app, which is strictly worse
	     than AlarmKit not firing yet. Regardless of how this resolves,
	     IosHybridNotificationScheduler already falls back to local
	     notifications on every iOS version, so the app builds, runs, and
	     reliably delivers prayer alerts without this. -->
</dict>
</plist>
