<?xml version="1.0" encoding="utf-8"?>
<!-- Native "Allah Is Calling" block screen. Deliberately NOT a Flutter
     Activity: a second Flutter engine started from a background service was
     painting only the window background (solid green) and never the Dart
     UI — see GuardBlockActivity.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_deep_green"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Avatar circle -->
        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/guard_avatar_circle">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerInside" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Allah Is Calling"
            android:textColor="@color/guard_ivory"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guard_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:text="PRAYER"
            android:textAllCaps="true"
            android:textColor="@color/guard_soft_gold"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guard_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:text="Your apps have been blocked.\nGet up and pray."
            android:textColor="@color/guard_ivory"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guard_unlock_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Your apps unlock in"
            android:textColor="@color/guard_ivory_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/guard_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="15:00"
            android:textColor="@color/guard_soft_gold"
            android:textSize="42sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/guard_decline"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:background="@drawable/guard_decline_circle"
                    android:contentDescription="Decline"
                    android:padding="20dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_call"
                    android:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Decline"
                    android:textColor="#EF9A9A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/guard_answer"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/guard_answer_circle"
                    android:contentDescription="Answer"
                    android:padding="22dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_call"
                    android:tint="@color/guard_deep_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Answer"
                    android:textColor="@color/guard_soft_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
