# Copy this file to android/key.properties and fill in the real values.
# key.properties and *.jks are gitignored — NEVER commit them.
#
# Create the upload keystore first:
#   keytool -genkey -v -keystore %USERPROFILE%\upload-keystore.jks ^
#     -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# See RELEASE_CHECKLIST.md for the full release procedure.

storeFile=C:/Users/YOUR_USER/upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
